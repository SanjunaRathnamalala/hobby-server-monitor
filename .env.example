# Google OAuth 2.0 (Google Cloud console → Google Auth Platform → Clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:4321/api/auth/callback

# The Google email that becomes the first admin (must be verified by Google)
BOOTSTRAP_ADMIN_EMAIL=

# Where data is stored (relative to the backend/ folder)
HSM_DATA_DIR=data
HSM_DB_PATH=data/hsm.db

# Session cookie: keep true; browsers allow secure cookies on http://localhost
COOKIE_SECURE=true

# Address of the dashboard in the browser. Changing requests from other origins are refused.
APP_ORIGIN=http://localhost:4321
