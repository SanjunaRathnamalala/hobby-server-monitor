---
// One page. All data comes from the Falcon API on the same origin.
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hobby Server Monitor</title>
    <style is:global>
      :root { color-scheme: light dark; --bg:#f6f7f9; --card:#fff; --text:#1d2330; --muted:#6b7280; --line:#e3e6ea; --accent:#2f6fde; --bad:#c62828; }
      @media (prefers-color-scheme: dark) { :root { --bg:#14171c; --card:#1d2128; --text:#e6e8eb; --muted:#9aa3ae; --line:#2c323b; --accent:#6b9cff; --bad:#ff6b6b; } }
      * { box-sizing: border-box; }
      body { margin:0; font:14px/1.5 system-ui, sans-serif; background:var(--bg); color:var(--text); }
      header { display:flex; justify-content:space-between; align-items:center; gap:8px; padding:12px 16px; border-bottom:1px solid var(--line); background:var(--card); }
      h1 { font-size:18px; margin:0; } h2 { font-size:16px; margin:0 0 8px; } h3 { font-size:14px; margin:16px 0 6px; }
      main { max-width:1200px; margin:0 auto; padding:16px; display:grid; gap:16px; }
      .card { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:16px; }
      .scroll { overflow-x:auto; }
      table { border-collapse:collapse; width:100%; }
      th, td { text-align:left; padding:6px 8px; border-bottom:1px solid var(--line); white-space:nowrap; }
      tr.click { cursor:pointer; } tr.sel { background:color-mix(in srgb, var(--accent) 12%, transparent); }
      .st { padding:1px 6px; border-radius:4px; font-size:12px; }
      .running { background:#1f8a4c22; color:#1f8a4c; } .stopped { background:#88888822; } .frozen { background:#2f6fde22; color:var(--accent); }
      .error { color:var(--bad); } .muted { color:var(--muted); } .info { color:var(--accent); }
      button, .button { font:inherit; padding:5px 10px; border:1px solid var(--line); border-radius:6px; background:var(--card); color:var(--text); cursor:pointer; text-decoration:none; display:inline-block; }
      button:hover, .button:hover { border-color:var(--accent); } .danger { color:var(--bad); }
      input, select { font:inherit; padding:4px 6px; border:1px solid var(--line); border-radius:6px; background:var(--bg); color:var(--text); }
      .row { display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin:8px 0; }
      .grid { display:grid; gap:8px; max-width:560px; } .grid label { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
      .wide { flex:1; min-width:200px; }
      .term { background:#0d1117; color:#d1d5da; padding:10px; border-radius:6px; max-height:320px; overflow:auto; white-space:pre-wrap; }
      .chart svg { width:100%; height:150px; border:1px solid var(--line); border-radius:6px; }
      .key-mem { color:#2a7; } .key-cpu { color:#36c; } .chip { font-size:12px; padding:1px 6px; margin-right:4px; }
      #notice:empty { display:none; } .login { max-width:380px; margin:40px auto; text-align:center; }
    </style>
  </head>
  <body>
    <header><h1>Hobby Server Monitor</h1><div id="who"></div></header>
    <main id="app"><p>Loading…</p></main>
    <script>import "../scripts/app.js";</script>
  </body>
</html>
